{
  "_comment": "Held-out set. Labeled AFTER the matcher was tuned on github.gold.json but BEFORE inspecting the matcher's output for these cases. Roughly half cover parameters the first set never touched (reaction_id, role_id, check_suite_id, alert_number, asset_id, ruleset_id, commit_sha, repository_id, package_version_id); the rest use new consumers of already-seen parameters to test consistency. Same schema as github.gold.json.",
  "toolkit": "github",
  "cases": [
    {
      "consumer": "GITHUB_ADD_LABELS_TO_AN_ISSUE",
      "param": "issue_number",
      "accept": ["GITHUB_LIST_REPOSITORY_ISSUES", "GITHUB_CREATE_AN_ISSUE"],
      "reject": ["GITHUB_GET_AN_ISSUE", "GITHUB_LIST_LABELS_FOR_AN_ISSUE"]
    },
    {
      "consumer": "GITHUB_LIST_REVIEW_COMMENTS_ON_A_PULL_REQUEST",
      "param": "pull_number",
      "accept": ["GITHUB_LIST_PULL_REQUESTS", "GITHUB_CREATE_A_PULL_REQUEST"],
      "reject": ["GITHUB_CREATE_A_CHECK_RUN", "GITHUB_GET_A_PULL_REQUEST"]
    },
    {
      "consumer": "GITHUB_DELETE_ISSUE_COMMENT",
      "param": "comment_id",
      "accept": ["GITHUB_LIST_ISSUE_COMMENTS", "GITHUB_LIST_ISSUE_COMMENTS_FOR_A_REPOSITORY", "GITHUB_CREATE_AN_ISSUE_COMMENT"],
      "reject": ["GITHUB_LIST_COMMIT_COMMENTS", "GITHUB_LIST_GIST_COMMENTS", "GITHUB_GET_AN_ISSUE_COMMENT"]
    },
    {
      "consumer": "GITHUB_DELETE_COMMIT_COMMENT",
      "param": "comment_id",
      "accept": ["GITHUB_LIST_COMMIT_COMMENTS", "GITHUB_LIST_COMMIT_COMMENTS_FOR_A_REPOSITORY", "GITHUB_CREATE_A_COMMIT_COMMENT"],
      "reject": ["GITHUB_LIST_ISSUE_COMMENTS", "GITHUB_LIST_GIST_COMMENTS"]
    },
    {
      "consumer": "GITHUB_DELETE_GIST_COMMENT",
      "param": "comment_id",
      "accept": ["GITHUB_LIST_GIST_COMMENTS", "GITHUB_CREATE_A_GIST_COMMENT"],
      "reject": ["GITHUB_LIST_ISSUE_COMMENTS", "GITHUB_LIST_COMMIT_COMMENTS"]
    },
    {
      "consumer": "GITHUB_DELETE_GIST",
      "param": "gist_id",
      "accept": ["GITHUB_LIST_GISTS_FOR_THE_AUTHENTICATED_USER", "GITHUB_CREATE_A_GIST"],
      "reject": ["GITHUB_GET_GIST"]
    },
    {
      "consumer": "GITHUB_DELETE_A_REPOSITORY_WEBHOOK",
      "param": "hook_id",
      "accept": ["GITHUB_LIST_REPOSITORY_WEBHOOKS", "GITHUB_CREATE_A_REPOSITORY_WEBHOOK"],
      "reject": ["GITHUB_LIST_ORGANIZATION_WEBHOOKS", "GITHUB_CREATE_AN_ORGANIZATION_WEBHOOK"]
    },
    {
      "consumer": "GITHUB_GET_AN_ORGANIZATION_WEBHOOK",
      "param": "hook_id",
      "accept": ["GITHUB_LIST_ORGANIZATION_WEBHOOKS", "GITHUB_CREATE_AN_ORGANIZATION_WEBHOOK"],
      "reject": ["GITHUB_LIST_REPOSITORY_WEBHOOKS", "GITHUB_CREATE_A_REPOSITORY_WEBHOOK"]
    },
    {
      "consumer": "GITHUB_DELETE_A_WORKFLOW_RUN",
      "param": "run_id",
      "accept": ["GITHUB_LIST_WORKFLOW_RUNS_FOR_A_REPOSITORY", "GITHUB_LIST_WORKFLOW_RUNS_FOR_A_WORKFLOW"],
      "reject": ["GITHUB_LIST_CHECK_RUNS_FOR_A_REF", "GITHUB_GET_A_WORKFLOW_RUN"]
    },
    {
      "consumer": "GITHUB_LIST_JOBS_FOR_A_WORKFLOW_RUN",
      "param": "run_id",
      "accept": ["GITHUB_LIST_WORKFLOW_RUNS_FOR_A_REPOSITORY", "GITHUB_LIST_WORKFLOW_RUNS_FOR_A_WORKFLOW"],
      "reject": ["GITHUB_LIST_CHECK_RUNS_FOR_A_REF", "GITHUB_GET_A_WORKFLOW_RUN"]
    },
    {
      "consumer": "GITHUB_GET_AN_ARTIFACT",
      "param": "artifact_id",
      "accept": ["GITHUB_LIST_ARTIFACTS_FOR_A_REPOSITORY", "GITHUB_LIST_WORKFLOW_RUN_ARTIFACTS"],
      "reject": ["GITHUB_GET_AN_ARTIFACT"]
    },
    {
      "consumer": "GITHUB_UPDATE_A_CHECK_RUN",
      "param": "check_run_id",
      "accept": ["GITHUB_LIST_CHECK_RUNS_FOR_A_REF", "GITHUB_LIST_CHECK_RUNS_IN_A_CHECK_SUITE", "GITHUB_CREATE_A_CHECK_RUN"],
      "reject": ["GITHUB_LIST_WORKFLOW_RUNS_FOR_A_REPOSITORY", "GITHUB_GET_CHECK_RUN"]
    },
    {
      "consumer": "GITHUB_GET_CHECK_SUITE",
      "param": "check_suite_id",
      "accept": ["GITHUB_LIST_CHECK_SUITES_FOR_A_GIT_REFERENCE", "GITHUB_CREATE_A_CHECK_SUITE"],
      "reject": ["GITHUB_LIST_REPOSITORY_RULE_SUITES", "GITHUB_GET_A_REPOSITORY_RULE_SUITE"]
    },
    {
      "consumer": "GITHUB_GET_A_RELEASE_ASSET",
      "param": "asset_id",
      "accept": ["GITHUB_LIST_RELEASE_ASSETS"],
      "reject": ["GITHUB_GET_A_RELEASE_ASSET"]
    },
    {
      "consumer": "GITHUB_GET_A_REPOSITORY_RULESET",
      "param": "ruleset_id",
      "accept": ["GITHUB_LIST_REPOSITORY_RULESETS", "GITHUB_CREATE_A_REPOSITORY_RULESET"],
      "reject": []
    },
    {
      "consumer": "GITHUB_DELETE_ISSUE_REACTION",
      "param": "reaction_id",
      "accept": ["GITHUB_LIST_REACTIONS_FOR_AN_ISSUE", "GITHUB_CREATE_REACTION_FOR_AN_ISSUE"],
      "reject": ["GITHUB_LIST_REACTIONS_FOR_AN_ISSUE_COMMENT", "GITHUB_LIST_REACTIONS_FOR_A_RELEASE", "GITHUB_CREATE_REACTION_FOR_AN_ISSUE_COMMENT"]
    },
    {
      "consumer": "GITHUB_DELETE_A_RELEASE_REACTION",
      "param": "reaction_id",
      "accept": ["GITHUB_LIST_REACTIONS_FOR_A_RELEASE", "GITHUB_CREATE_REACTION_FOR_A_RELEASE"],
      "reject": ["GITHUB_LIST_REACTIONS_FOR_AN_ISSUE", "GITHUB_CREATE_REACTION_FOR_AN_ISSUE"]
    },
    {
      "consumer": "GITHUB_GET_AN_ORGANIZATION_ROLE",
      "param": "role_id",
      "accept": ["GITHUB_LIST_ORGANIZATION_ROLES_FOR_AN_ORGANIZATION", "GITHUB_CREATE_A_CUSTOM_ORGANIZATION_ROLE"],
      "reject": []
    },
    {
      "consumer": "GITHUB_GET_CODE_SCANNING_ALERT",
      "param": "alert_number",
      "accept": ["GITHUB_LIST_CODE_SCANNING_ALERTS_FOR_A_REPOSITORY", "GITHUB_LIST_CODE_SCANNING_ALERTS_FOR_AN_ORGANIZATION"],
      "reject": ["GITHUB_LIST_SECRET_SCANNING_ALERTS_FOR_A_REPOSITORY"]
    },
    {
      "consumer": "GITHUB_GET_A_PACKAGE_VERSION_FOR_AN_ORGANIZATION",
      "param": "package_version_id",
      "accept": ["GITHUB_LIST_ORG_PACKAGE_VERSIONS"],
      "reject": ["GITHUB_LIST_OWNED_PACKAGE_VERSIONS", "GITHUB_LIST_PACKAGE_VERSIONS_FOR_A_PACKAGE_OWNED_BY_A_USER"]
    },
    {
      "consumer": "GITHUB_ENABLE_REPO_FOR_GITHUB_ACTIONS",
      "param": "repository_id",
      "accept": ["GITHUB_LIST_ORGANIZATION_REPOSITORIES", "GITHUB_LIST_REPOSITORIES_FOR_THE_AUTHENTICATED_USER", "GITHUB_LIST_REPOSITORIES_FOR_A_USER", "GITHUB_CREATE_AN_ORGANIZATION_REPOSITORY", "GITHUB_CREATE_REPOSITORY"],
      "reject": ["GITHUB_GET_A_THREAD", "GITHUB_GET_CHECK_SUITE", "GITHUB_GET_A_WORKFLOW_RUN", "GITHUB_CREATE_AN_ISSUE"]
    },
    {
      "consumer": "GITHUB_ADD_REPOSITORY_TO_APP_INSTALLATION",
      "param": "repository_id",
      "accept": ["GITHUB_LIST_ORGANIZATION_REPOSITORIES", "GITHUB_LIST_REPOSITORIES_FOR_THE_AUTHENTICATED_USER", "GITHUB_LIST_REPOSITORIES_FOR_A_USER", "GITHUB_CREATE_AN_ORGANIZATION_REPOSITORY", "GITHUB_CREATE_REPOSITORY"],
      "reject": ["GITHUB_GET_A_THREAD", "GITHUB_GET_CHECK_SUITE", "GITHUB_GET_A_WORKFLOW_RUN", "GITHUB_CREATE_AN_ISSUE"]
    },
    {
      "consumer": "GITHUB_CREATE_A_COMMIT_COMMENT",
      "param": "commit_sha",
      "accept": ["GITHUB_LIST_COMMITS", "GITHUB_CREATE_A_COMMIT"],
      "reject": ["GITHUB_GET_A_WORKFLOW_RUN", "GITHUB_GET_CHECK_SUITE", "GITHUB_CREATE_REACTION_FOR_A_COMMIT_COMMENT"]
    },
    {
      "consumer": "GITHUB_LIST_PULL_REQUESTS_ASSOCIATED_WITH_A_COMMIT",
      "param": "commit_sha",
      "accept": ["GITHUB_LIST_COMMITS", "GITHUB_CREATE_A_COMMIT"],
      "reject": ["GITHUB_GET_A_WORKFLOW_RUN", "GITHUB_GET_CHECK_SUITE"]
    },
    {
      "consumer": "GITHUB_DISMISS_A_REVIEW_FOR_A_PULL_REQUEST",
      "param": "review_id",
      "accept": ["GITHUB_LIST_REVIEWS_FOR_A_PULL_REQUEST", "GITHUB_CREATE_A_REVIEW_FOR_A_PULL_REQUEST"],
      "reject": ["GITHUB_CREATE_A_REVIEW_COMMENT_FOR_A_PULL_REQUEST", "GITHUB_GET_A_REVIEW_FOR_A_PULL_REQUEST"]
    },
    {
      "consumer": "GITHUB_UPDATE_A_MILESTONE",
      "param": "milestone_number",
      "accept": ["GITHUB_LIST_MILESTONES", "GITHUB_CREATE_A_MILESTONE"],
      "reject": ["GITHUB_GET_A_MILESTONE"]
    },
    {
      "consumer": "GITHUB_DELETE_A_RELEASE",
      "param": "release_id",
      "accept": ["GITHUB_LIST_RELEASES", "GITHUB_CREATE_A_RELEASE"],
      "reject": ["GITHUB_GET_A_RELEASE", "GITHUB_LIST_RELEASE_ASSETS"]
    },
    {
      "consumer": "GITHUB_CREATE_A_DISCUSSION",
      "param": "team_slug",
      "accept": ["GITHUB_LIST_TEAMS", "GITHUB_CREATE_A_TEAM"],
      "reject": ["GITHUB_GET_A_TEAM_BY_NAME"]
    },
    {
      "consumer": "GITHUB_DELETE_ACCESS_RESTRICTIONS",
      "param": "branch",
      "accept": ["GITHUB_LIST_BRANCHES"],
      "reject": ["GITHUB_LIST_DEPLOYMENT_BRANCH_POLICIES", "GITHUB_GET_A_BRANCH"]
    },
    {
      "consumer": "GITHUB_EXPORT_A_CODESPACE_FOR_THE_AUTHENTICATED_USER",
      "param": "codespace_name",
      "accept": ["GITHUB_LIST_CODESPACES_FOR_THE_AUTHENTICATED_USER", "GITHUB_CREATE_A_CODESPACE_FOR_THE_AUTHENTICATED_USER"],
      "reject": ["GITHUB_GET_CODESPACE"]
    },
    {
      "consumer": "GITHUB_GET_A_PACKAGE_FOR_A_USER",
      "param": "package_name",
      "accept": ["GITHUB_LIST_PACKAGES_FOR_A_USER"],
      "reject": ["GITHUB_LIST_PACKAGES_FOR_AN_ORGANIZATION"]
    },
    {
      "consumer": "GITHUB_DELETE_DISCUSSION",
      "param": "discussion_number",
      "accept": ["GITHUB_LIST_DISCUSSIONS", "GITHUB_CREATE_A_DISCUSSION"],
      "reject": ["GITHUB_GET_DISCUSSION"]
    }
  ],
  "negatives": [
    { "consumer": "GITHUB_CREATE_A_LABEL", "param": "name", "reason": "name of the label being created" },
    { "consumer": "GITHUB_CREATE_A_TEAM", "param": "name", "reason": "name of the team being created" },
    { "consumer": "GITHUB_CREATE_A_DISCUSSION", "param": "title", "reason": "free text" },
    { "consumer": "GITHUB_CREATE_A_DISCUSSION", "param": "body", "reason": "free text" },
    { "consumer": "GITHUB_CREATE_A_BLOB", "param": "content", "reason": "free-form content supplied by the user" },
    { "consumer": "GITHUB_CREATE_REACTION_FOR_AN_ISSUE", "param": "content", "reason": "enum (+1, heart, ...)" },
    { "consumer": "GITHUB_CREATE_A_GIST_COMMENT", "param": "body", "reason": "free text" }
  ],
  "ambiguous": [
    { "consumer": "GITHUB_GET_A_PROJECT", "param": "project_number", "reason": "projects v2: depends on org vs user scope the tool targets" },
    { "consumer": "GITHUB_CREATE_A_DEPLOYMENT", "param": "ref", "reason": "a branch/tag/sha; could come from LIST_BRANCHES or be typed" },
    { "consumer": "GITHUB_CREATE_A_WORKFLOW_DISPATCH_EVENT", "param": "ref", "reason": "a branch/tag; could come from LIST_BRANCHES or be typed" },
    { "consumer": "GITHUB_REMOVE_A_LABEL_FROM_AN_ISSUE", "param": "name", "reason": "label name; could come from LIST_LABELS_FOR_AN_ISSUE" }
  ]
}
