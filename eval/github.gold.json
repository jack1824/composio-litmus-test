  "negatives": [
    { "consumer": "GITHUB_CREATE_AN_ISSUE_COMMENT", "param": "owner", "reason": "ambient context: the user's/ the agent's repo scope, not a per-call dependency" },
    { "consumer": "GITHUB_CREATE_AN_ISSUE_COMMENT", "param": "repo", "reason": "ambient context" },
    { "consumer": "GITHUB_MERGE_A_PULL_REQUEST", "param": "owner", "reason": "ambient context" },
    { "consumer": "GITHUB_MERGE_A_PULL_REQUEST", "param": "repo", "reason": "ambient context" },
    { "consumer": "GITHUB_CREATE_AN_ISSUE_COMMENT", "param": "body", "reason": "free text authored by the user" },
    { "consumer": "GITHUB_CREATE_AN_ISSUE", "param": "title", "reason": "free text authored by the user" },
    { "consumer": "GITHUB_CREATE_A_COMMIT", "param": "message", "reason": "free text authored by the user" },
    { "consumer": "GITHUB_DELETE_PACKAGE", "param": "package_type", "reason": "enum chosen by the user, never produced by a tool" },
    { "consumer": "GITHUB_CREATE_A_COMMIT_STATUS", "param": "state", "reason": "enum chosen by the user" },
    { "consumer": "GITHUB_CREATE_A_CHECK_RUN", "param": "name", "reason": "name of the check run being created" },
    { "consumer": "GITHUB_CREATE_A_REFERENCE", "param": "ref", "reason": "name of the ref being created" },
    { "consumer": "GITHUB_CREATE_OR_UPDATE_A_REPOSITORY_SECRET", "param": "secret_name", "reason": "user-chosen name of the secret being written" },
